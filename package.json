{
  "name": "@quaivault/cli",
  "version": "0.1.0",
  "description": "Command-line client for QuaiVault multisig vaults on Quai Network",
  "license": "MIT",
  "author": "QuaiVault",
  "homepage": "https://quaivault.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quai-Vault/quaivault-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Quai-Vault/quaivault-cli/issues"
  },
  "keywords": [
    "quai",
    "quainetwork",
    "multisig",
    "quaivault",
    "cli",
    "wallet"
  ],
  "type": "module",
  "bin": {
    "quaivault": "./dist/qv.js",
    "qv": "./dist/qv.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@inquirer/password": "5.1.1",
    "@inquirer/prompts": "8.5.2",
    "@quaivault/sdk": "0.6.0",
    "commander": "15.0.0",
    "picocolors": "1.1.1",
    "quais": "1.0.0-alpha.56",
    "smol-toml": "1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.9"
  }
}
